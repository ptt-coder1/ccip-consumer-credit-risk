	column 'Payment Affordability Band' = ```
				VAR Ratio = 'dw fact_loan'[income_to_annuity_ratio]
				RETURN
				    SWITCH(
				        TRUE(),
				        ISBLANK(Ratio), "Unknown",
				        Ratio < 4.5, "T1 <4.5x",
				        Ratio < 6.25, "T2 4.5-6.25x",
				        Ratio < 9.0, "T3 6.25-9x",
				        "T4 >=9x"
				    )
			```
		lineageTag: 8a9b0c1d-2e3f-4a5b-6c7d-8e9f0a1b2c3d
		summarizeBy: none
		sortByColumn: 'Payment Affordability Sort'

	column 'Payment Affordability Sort' = ```
				VAR Ratio = 'dw fact_loan'[income_to_annuity_ratio]
				RETURN
				    SWITCH(
				        TRUE(),
				        ISBLANK(Ratio), 5,
				        Ratio < 4.5, 1,
				        Ratio < 6.25, 2,
				        Ratio < 9.0, 3,
				        4
				    )
			```
		formatString: 0
		lineageTag: 9b0c1d2e-3f4a-5b6c-7d8e-9f0a1b2c3d4e
		summarizeBy: sum

