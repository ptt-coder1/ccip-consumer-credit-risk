	column _created_at
		dataType: dateTime
		formatString: General Date
		lineageTag: 14e70ff1-b768-4b57-90b7-7b0f93298d58
		summarizeBy: none
		sourceColumn: _created_at

		variation Variation
			isDefault
			relationship: 12abe531-ab12-406d-be3c-70c3b8eb2604
