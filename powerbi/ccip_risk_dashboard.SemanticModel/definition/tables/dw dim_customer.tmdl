	column 'Relative Risk Segment' = ```
				VAR Score = 'dw dim_customer'[ext_score_avg]
				RETURN
				    SWITCH(
				        TRUE(),
				        ISBLANK(Score), "Unknown",
				        Score >= 0.6276, "Q1 - Lowest Risk",
				        Score >= 0.5144, "Q2 - Low-Moderate Risk",
				        Score >= 0.3868, "Q3 - Moderate-High Risk",
				        "Q4 - Highest Risk"
				    )
			```
		lineageTag: 4d5e6f7a-8b9c-0d1e-2f3a-4b5c6d7e8f9a
		summarizeBy: none
		sortByColumn: 'Relative Risk Segment Sort'

	column 'Relative Risk Segment Sort' = ```
				VAR Score = 'dw dim_customer'[ext_score_avg]
				RETURN
				    SWITCH(
				        TRUE(),
				        ISBLANK(Score), 5,
				        Score >= 0.6276, 1,
				        Score >= 0.5144, 2,
				        Score >= 0.3868, 3,
				        4
				    )
			```
		formatString: 0
		lineageTag: 5e6f7a8b-9c0d-1e2f-3a4b-5c6d7e8f9a0b
		summarizeBy: sum

	column 'Bureau Delinquency Status' = ```
				VAR LateMonths = 'dw dim_customer'[num_late_payment_months]
				VAR MaxOverdue = 'dw dim_customer'[max_overdue_days]
				RETURN
				    IF(
				        LateMonths > 0 || MaxOverdue > 0,
				        "Delinquency History (Past Late)",
				        "Clean History (Never Late)"
				    )
			```
		lineageTag: 7a8b9c0d-1e2f-3a4b-5c6d-8e9f0a1b2c3d
		summarizeBy: none
		sortByColumn: 'Bureau Delinquency Sort'

	column 'Bureau Delinquency Sort' = ```
				VAR LateMonths = 'dw dim_customer'[num_late_payment_months]
				VAR MaxOverdue = 'dw dim_customer'[max_overdue_days]
				RETURN
				    IF(LateMonths > 0 || MaxOverdue > 0, 1, 2)
			```
		formatString: 0
		lineageTag: 8b9c0d1e-2f3a-4b5c-6d7e-9f0a1b2c3d4e

	column 'Age Group Sort' = ```
				VAR _Age = 'dw dim_customer'[age_years]
				RETURN
				    SWITCH(
				        TRUE(),
				        ISBLANK(_Age), 6,
				        _Age < 25, 1,
				        _Age < 35, 2,
				        _Age < 45, 3,
				        _Age < 55, 4,
				        5
				    )
			```
		formatString: 0
		lineageTag: 3c4d5e6f-7a8b-9c0d-1e2f-0a1b2c3d4e5f

	column 'Income Type Clean' = ```
				SWITCH(
				    'dw dim_customer'[income_type],
				    "Working", "Working",
				    "Commercial associate", "Commercial associate",
				    "Pensioner", "Pensioner",
				    "State servant", "State servant",
				    "Other (Low Sample)"
				)
			```
		lineageTag: 5e6f7a8b-9c0d-1e2f-3a4b-2c3d4e5f6a7b
		summarizeBy: none
		sortByColumn: 'Income Type Clean Sort'

	column 'Income Type Clean Sort' = ```
				SWITCH(
				    'dw dim_customer'[income_type],
				    "Working", 1,
				    "Commercial associate", 2,
				    "State servant", 3,
				    "Pensioner", 4,
				    5
				)
			```
		formatString: 0
		lineageTag: 6f7a8b9c-0d1e-2f3a-4b5c-3d4e5f6a7b8c
		summarizeBy: sum

